<idea-plugin>
    <id>dev.avinlang.avin</id>
    <name>Avin</name>
    <vendor url="https://github.com/avin-lang">avin-lang</vendor>
    <description><![CDATA[
    Support for <b>Avin</b>, a natively compiled, garbage-collected application language with a
    light, indentation-based syntax.
    <ul>
      <li>Syntax highlighting, bracket matching, auto-closing pairs and <code>//</code> line comments
          for <code>.avin</code> files, and for literate <code>.lavin</code> files (Markdown prose
          with the indented code in Avin); the prose has colours of its own, set in Settings | Editor |
          Color Scheme | Avin, and the program keeps the colours of Avin code</li>
      <li>Syntax highlighting, comments, brackets, the Sysl icon and the Sysl language server
          (<code>sysl lsp --stdio</code>) for <code>.sysl</code> files, which Avin projects contain</li>
      <li>The Avin language server (<code>avin lsp --stdio</code>) through LSP4IJ: diagnostics,
          hover, go to definition and the file structure</li>
      <li>Run configurations for <code>avin run</code> and <code>avin test</code>, with ▶ in the gutter
          on <code>main</code> and on each <code>@test</code>, test results in the test runner, and
          traps and diagnostics linked to the source in the console</li>
      <li>Avin projects: a New Project wizard entry for a program or a library, packages recognised
          by their <code>avin.hocon</code> (sources, tests and build output marked), chains of
          module directories shown on one line as <code>a.b.c</code> with the module icon, and
          New | Avin File (or test file) and New | Avin Module, headed with their module</li>
      <li>Settings | Languages &amp; Frameworks | Avin chooses the server executable, or a checkout
          of the Avin repository to run it from</li>
    </ul>
    ]]></description>

    <dependencies>
        <module name="intellij.platform.smRunner"/>
        <module name="intellij.platform.testRunner"/>
    </dependencies>

    <depends>com.intellij.modules.platform</depends>
    <depends>org.jetbrains.plugins.textmate</depends>
    <depends>com.redhat.devtools.lsp4ij</depends>

    <extensions defaultExtensionNs="com.intellij">
        <textmate.bundleProvider implementation="dev.avinlang.intellij.AvinBundleProvider"/>
        <editorHighlighterProvider filetype="textmate" order="first"
                                   implementationClass="dev.avinlang.intellij.AvinEditorHighlighterProvider"/>
        <colorSettingsPage implementation="dev.avinlang.intellij.AvinColorSettingsPage"/>
        <additionalTextAttributes scheme="Default" file="colorSchemes/AvinDefault.xml"/>
        <additionalTextAttributes scheme="Darcula" file="colorSchemes/AvinDarcula.xml"/>
        <fileIconProvider implementation="dev.avinlang.intellij.AvinFileIconProvider" order="first"/>
        <applicationConfigurable parentId="language"
                                 instance="dev.avinlang.intellij.AvinConfigurable"
                                 id="dev.avinlang.avin.settings"
                                 displayName="Avin"/>
        <notificationGroup id="Avin" displayType="BALLOON"/>
        <configurationType implementation="dev.avinlang.intellij.run.AvinConfigurationType"/>
        <runConfigurationProducer implementation="dev.avinlang.intellij.run.AvinRunConfigurationProducer"/>
        <codeInsight.lineMarkerProvider language="textmate"
                                        implementationClass="dev.avinlang.intellij.run.AvinRunLineMarkerProvider"/>
        <postStartupActivity implementation="dev.avinlang.intellij.project.AvinProjectActivity"/>
        <treeStructureProvider implementation="dev.avinlang.intellij.project.AvinModuleTreeStructureProvider"/>
        <internalFileTemplate name="Avin File"/>
        <internalFileTemplate name="Avin Test File"/>
        <newProjectWizard.languageGenerator implementation="dev.avinlang.intellij.project.AvinNewProjectWizard"/>
    </extensions>

    <projectListeners>
        <listener class="dev.avinlang.intellij.project.AvinManifestListener"
                  topic="com.intellij.openapi.vfs.newvfs.BulkFileListener"/>
    </projectListeners>

    <actions>
        <action id="Avin.NewFile" class="dev.avinlang.intellij.project.CreateAvinFileAction"
                text="Avin File" description="Creates an Avin file headed with its module">
            <add-to-group group-id="NewGroup" anchor="before" relative-to-action="NewFile"/>
        </action>
        <action id="Avin.NewModule" class="dev.avinlang.intellij.project.CreateAvinModuleAction"
                text="Avin Module" description="Creates an Avin module: its directory and a first file">
            <add-to-group group-id="NewGroup" anchor="after" relative-to-action="Avin.NewFile"/>
        </action>
    </actions>

    <extensions defaultExtensionNs="com.redhat.devtools.lsp4ij">
        <server id="avinLanguageServer"
                name="Avin"
                factoryClass="dev.avinlang.intellij.AvinLanguageServerFactory">
            <description><![CDATA[
            The Avin language server, started as <code>avin lsp --stdio</code> or from a checkout of
            the Avin repository (Settings | Languages &amp; Frameworks | Avin).
            ]]></description>
        </server>
        <server id="syslLanguageServer"
                name="Sysl"
                factoryClass="dev.avinlang.intellij.SyslLanguageServerFactory">
            <description><![CDATA[
            The Sysl language server, started as <code>sysl lsp --stdio</code> with <code>sysl</code>
            found on the PATH.
            ]]></description>
        </server>
        <fileNamePatternMapping patterns="*.sysl"
                                serverId="syslLanguageServer"
                                languageId="sysl"/>
        <fileNamePatternMapping patterns="*.avin"
                                serverId="avinLanguageServer"
                                languageId="avin"/>
        <fileNamePatternMapping patterns="*.lavin"
                                serverId="avinLanguageServer"
                                languageId="avin-literate"/>
    </extensions>
</idea-plugin>
